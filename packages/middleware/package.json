{
  "name": "@derodero24/comprs-middleware",
  "version": "1.0.0",
  "description": "HTTP compression middleware powered by comprs. Supports Express, Fastify, and Hono with zstd, brotli, gzip, and deflate.",
  "license": "MIT",
  "author": "derodero24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derodero24/comprs.git",
    "directory": "packages/middleware"
  },
  "homepage": "https://github.com/derodero24/comprs/tree/develop/packages/middleware",
  "bugs": {
    "url": "https://github.com/derodero24/comprs/issues"
  },
  "keywords": [
    "compression",
    "middleware",
    "express",
    "fastify",
    "hono",
    "zstd",
    "brotli",
    "gzip",
    "http",
    "content-encoding"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome ci",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "attw": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "publint": "publint"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "@derodero24/comprs": "^2.0.2",
    "fastify": "^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@derodero24/comprs": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.4",
    "express": "^5.1.0",
    "fastify": "^5.0.0",
    "hono": "^4.12.25",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
