{
  "name": "@derodero24/comprs",
  "version": "2.0.2",
  "description": "Rust-powered universal compression for JavaScript/TypeScript. zstd, gzip, brotli, and lz4 in one package.",
  "license": "MIT",
  "author": "derodero24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derodero24/comprs.git"
  },
  "homepage": "https://github.com/derodero24/comprs",
  "bugs": {
    "url": "https://github.com/derodero24/comprs/issues"
  },
  "keywords": [
    "compress",
    "compression",
    "decompress",
    "zstd",
    "zstandard",
    "gzip",
    "brotli",
    "deflate",
    "lz4",
    "wasm",
    "wasm-bindgen",
    "rust",
    "napi-rs",
    "native",
    "typescript",
    "streaming",
    "web-streams"
  ],
  "sideEffects": [
    "./browser/index.js",
    "./browser/streams.js"
  ],
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./browser/index.d.ts",
          "default": "./browser/index.js"
        }
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./streams": {
      "browser": {
        "import": {
          "types": "./browser/streams.d.ts",
          "default": "./browser/streams.js"
        }
      },
      "import": {
        "types": "./streams.d.ts",
        "default": "./streams.js"
      },
      "require": {
        "types": "./streams.d.ts",
        "default": "./streams.js"
      }
    },
    "./node": {
      "import": {
        "types": "./node.d.ts",
        "default": "./node.js"
      },
      "require": {
        "types": "./node.d.ts",
        "default": "./node.js"
      }
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "streams.js",
    "streams.d.ts",
    "node.js",
    "node.d.ts",
    "browser/package.json",
    "browser/index.js",
    "browser/index.d.ts",
    "browser/streams.js",
    "browser/streams.d.ts",
    "browser/comprs-wasm.js",
    "browser/comprs-wasm.d.ts",
    "browser/comprs-wasm_bg.wasm"
  ],
  "napi": {
    "binaryName": "comprs",
    "dtsHeaderFile": "crates/core/dts-header.d.ts",
    "constEnum": false,
    "runtimeStringEnum": true,
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "napi build --manifest-path crates/core/Cargo.toml --platform --release --js index.js --dts index.d.ts --output-dir .",
    "build:debug": "napi build --manifest-path crates/core/Cargo.toml --platform --js index.js --dts index.d.ts --output-dir .",
    "build:js": "node scripts/build-js.mjs",
    "build:wasm-bindgen": "node scripts/build-wasm-bindgen.js",
    "size:wasm": "node scripts/wasm-size.mjs",
    "artifacts": "napi artifacts",
    "changeset:version": "changeset version && node scripts/sync-cargo-version.js && napi version && pnpm run build && pnpm run format",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "check": "biome ci --error-on-warnings",
    "format": "biome format --write",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:wasm": "vitest run __test__/wasm.spec.ts __test__/wasm-parity.spec.ts __test__/legacy-error-codes.spec.ts __test__/browser-entry.spec.ts __test__/browser-streams.spec.ts",
    "test:types": "node scripts/check-consumer-types.mjs",
    "test:watch": "vitest watch",
    "bench": "vitest bench",
    "bench:ci": "vitest bench --mode ci",
    "attw": "attw --pack .",
    "publint": "publint",
    "verify": "pnpm run check && cargo clippy --workspace --all-targets -- -D warnings && cargo test && pnpm run build && pnpm run build:js && pnpm run typecheck && pnpm test",
    "clean": "rm -rf target coverage *.node browser/comprs-wasm*",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@napi-rs/cli": "3.10.6",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lefthook": "^2.1.9",
    "pako": "^3.0.0",
    "publint": "^0.3.21",
    "typescript": "^7.0.0",
    "typescript-5": "npm:typescript@~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
